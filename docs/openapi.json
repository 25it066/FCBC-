  "components": {
    "schemas": {
      "Body_upload_api_datasets_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "mapping": {
            "type": "string",
            "title": "Mapping",
            "default": "{}"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_datasets_upload_post"
      },
      "Config": {
        "properties": {
          "duration": {
            "type": "number",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Duration",
            "default": 30
          },
          "stride": {
            "type": "number",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Stride",
            "default": 10
          },
          "episode_gap": {
            "type": "number",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Episode Gap",
            "default": 60
          },
          "threshold": {
            "type": "number",
            "maximum": 4.0,
            "minimum": -1.0,
            "title": "Threshold",
            "default": 0.55
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
          },
          "min_identity_coverage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Identity Coverage",
            "default": 0.8
          },
          "incomplete": {
            "type": "string",
            "enum": [
              "include",
              "drop"
            ],
            "title": "Incomplete",
            "default": "include"
          },
          "late_policy": {
            "type": "string",
            "const": "sort_recorded",
            "title": "Late Policy",
            "default": "sort_recorded"
          },
          "rename_enabled": {
            "type": "boolean",
